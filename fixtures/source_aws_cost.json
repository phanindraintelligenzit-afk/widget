import boto3
from datetime import date, timedelta
from botocore.exceptions import ClientError

# ----------------------------------------
# AWS Cost Explorer Client
# ----------------------------------------

ce = boto3.client("ce")

# ----------------------------------------
# DAILY COSTS
# ----------------------------------------

def get_daily_costs(days=30):
    print("\n========== DAILY COSTS ==========\n")

    end_date = date.today()
    start_date = end_date - timedelta(days=days)

    response = ce.get_cost_and_usage(
        TimePeriod={
            "Start": start_date.strftime("%Y-%m-%d"),
            "End": end_date.strftime("%Y-%m-%d")
        },
        Granularity="DAILY",
        Metrics=["UnblendedCost"]
    )

    for day in response["ResultsByTime"]:
        cost = day["Total"]["UnblendedCost"]["Amount"]
        print(f"{day['TimePeriod']['Start']} : ${float(cost):.2f}")


# ----------------------------------------
# MONTHLY COSTS
# ----------------------------------------

def get_monthly_costs():
    print("\n========== MONTHLY COSTS ==========\n")

    response = ce.get_cost_and_usage(
        TimePeriod={
            "Start": "2025-01-01",
            "End": date.today().strftime("%Y-%m-%d")
        },
        Granularity="MONTHLY",
        Metrics=["UnblendedCost"]
    )

    for month in response["ResultsByTime"]:
        cost = month["Total"]["UnblendedCost"]["Amount"]

        print(
            f"{month['TimePeriod']['Start']} : "
            f"${float(cost):.2f}"
        )


# ----------------------------------------
# COST BY AWS SERVICE
# ----------------------------------------

def get_service_costs():
    print("\n========== SERVICE COSTS ==========\n")

    first_day = date.today().replace(day=1)

    response = ce.get_cost_and_usage(
        TimePeriod={
            "Start": first_day.strftime("%Y-%m-%d"),
            "End": date.today().strftime("%Y-%m-%d")
        },
        Granularity="MONTHLY",
        Metrics=["UnblendedCost"],
        GroupBy=[
            {
                "Type": "DIMENSION",
                "Key": "SERVICE"
            }
        ]
    )

    for result in response["ResultsByTime"]:
        for group in result["Groups"]:
            service = group["Keys"][0]
            cost = group["Metrics"]["UnblendedCost"]["Amount"]

            print(
                f"{service:<40} "
                f"${float(cost):.2f}"
            )


# ----------------------------------------
# COST BY AGENT_ID TAG
# ----------------------------------------

def get_agent_costs():
    print("\n========== AGENT COSTS ==========\n")

    first_day = date.today().replace(day=1)

    response = ce.get_cost_and_usage(
        TimePeriod={
            "Start": first_day.strftime("%Y-%m-%d"),
            "End": date.today().strftime("%Y-%m-%d")
        },
        Granularity="MONTHLY",
        Metrics=["UnblendedCost"],
        GroupBy=[
            {
                "Type": "TAG",
                "Key": "agent_id"
            }
        ]
    )

    for result in response["ResultsByTime"]:
        for group in result["Groups"]:

            tag_name = group["Keys"][0]
            cost = group["Metrics"]["UnblendedCost"]["Amount"]

            print(
                f"{tag_name:<40} "
                f"${float(cost):.2f}"
            )


# ----------------------------------------
# SPECIFIC AGENT COST
# ----------------------------------------

def get_specific_agent_cost(agent_id):
    print(f"\n========== {agent_id} ==========\n")

    first_day = date.today().replace(day=1)

    response = ce.get_cost_and_usage(
        TimePeriod={
            "Start": first_day.strftime("%Y-%m-%d"),
            "End": date.today().strftime("%Y-%m-%d")
        },
        Granularity="MONTHLY",
        Metrics=["UnblendedCost"],
        Filter={
            "Tags": {
                "Key": "agent_id",
                "Values": [agent_id]
            }
        }
    )

    total_cost = 0

    for result in response["ResultsByTime"]:
        amount = result["Total"]["UnblendedCost"]["Amount"]
        total_cost += float(amount)

    print(f"Agent Cost = ${total_cost:.2f}")

    return total_cost


# ----------------------------------------
# DPI-LS FORMAT
# ----------------------------------------

def generate_dpi_ls_payload(agent_id):
    cost = get_specific_agent_cost(agent_id)

    payload = {
        "agent_id": agent_id,
        "agent_name": "Chandra",
        "cost": round(cost, 2)
    }

    print("\n========== DPI-LS PAYLOAD ==========\n")
    print(payload)

    return payload


# ----------------------------------------
# MAIN
# ----------------------------------------

if __name__ == "__main__":

    try:

        get_daily_costs()

        get_monthly_costs()

        get_service_costs()

        get_agent_costs()

        generate_dpi_ls_payload(
            "agent-chandra-001"
        )

    except ClientError as e:
        print(f"AWS Error: {e}")

    except Exception as e:
        print(f"Error: {e}")
