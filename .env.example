# AWS Configuration for Chandra FinOps
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>

# Database
DATABASE_URL=sqlite:///./dpi_ls.db

# Model Configuration
MODEL_NAME="qwen.qwen3-next-80b-a3b"
BEDROCK_MODEL_ID="qwen.qwen3-next-80b-a3b"

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
LANGFUSE_HOST=https://cloud.langfuse.com



OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317


# =========================================================
# Quality (Q) Dependencies & Integrations
# =========================================================

# LangSmith (LLM Observability & Hallucination tracking)
LANGSMITH_URL=https://smith.langchain.com

# AgentOps (Agent Behaviour & Session Tracking)
AGENTOPS_URL=https://app.agentops.ai
AGENTOPS_API_KEY=your_agentops_api_key_here

# Ragas (Automated LLM Evaluation, typically requires OpenAI for eval models)
RAGAS_URL=https://ragas.io
OPENAI_API_KEY=your_openai_api_key_here

# =========================================================
# Widget Configuration
# =========================================================
WIDGET_ALLOWED_ORIGINS=*

# Application Settings
LOOKBACK_DAYS=7
SEED_ON_START=false
MAPPINGS_DIR=./fixtures
PYDANTIC_DISABLE_PLUGINS=1