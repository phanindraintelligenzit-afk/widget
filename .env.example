# AWS Configuration for Chandra FinOps
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>

# Database
DATABASE_URL=sqlite:///./dpi_ls.db

# Model Configuration
MODEL_NAME="qwen.qwen3-next-80b-a3b"
BEDROCK_MODEL_ID="qwen.qwen3-next-80b-a3b"

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
LANGFUSE_HOST=https://cloud.langfuse.com

# Grafana Configuration
GRAFANA_URL=http://localhost:3000

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090

# Jaeger / OpenTelemetry Configuration
# Jaeger collector endpoint for trace submission
JAEGER_ENDPOINT=http://localhost:14268
JAEGER_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Zipkin Configuration
ZIPKIN_URL=http://localhost:9411

# Widget Configuration
WIDGET_ALLOWED_ORIGINS=*

# Application Settings
LOOKBACK_DAYS=7
SEED_ON_START=false
MAPPINGS_DIR=./fixtures
PYDANTIC_DISABLE_PLUGINS=1