# AWS Configuration for Bedrock
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
BEDROCK_MODEL_ID="qwen.qwen3-next-80b-a3b"

# Database Configuration
DPI_DB_URL=sqlite:///./dpi_ls.db
DPI_ENV=development

# Model Configuration
MODEL_NAME="qwen.qwen3-next-80b-a3b"

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
LANGFUSE_HOST=https://cloud.langfuse.com

# OTel / Tracing Endpoints
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_UI_URL=http://localhost:16686
SKYWALKING_UI_URL=http://localhost:8080

# AgentOps Configuration
AGENTOPS_API_KEY=your_agentops_api_key_here

# Widget Configuration
WIDGET_ALLOWED_ORIGINS=*

# Application Settings
LOOKBACK_DAYS=7
SEED_ON_START=false
MAPPINGS_DIR=./fixtures
PYDANTIC_DISABLE_PLUGINS=1

# SMTP Configuration (For Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
