# DPI-LS Production Environment Template

# Core Database configuration (PostgreSQL)
DPI_DB_URL=postgresql+psycopg2://dpi_user:dpi_password@postgres:5432
DPI_ENV=production

# Task Queue (Redis + Celery)
CELERY_BROKER_URL=redis://redis:6379
CELERY_RESULT_BACKEND=redis://redis:6379

# AWS Configuration (For Bedrock and Secrets Manager)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
BEDROCK_MODEL_ID="qwen.qwen3-next-80b-a3b"

# Telemetry / AgentOps
AGENTOPS_API_KEY=your_agentops_api_key_here

# Telemetry / Langfuse
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# OTel / Tracing Endpoints
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
JAEGER_ENDPOINT=http://otel-collector:14268
PROMETHEUS_URL=http://prometheus:9090

# Frontend Configuration
WIDGET_ALLOWED_ORIGINS=*

# SMTP Configuration (For Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
