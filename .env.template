# DPI-LS Production Environment Template

# Core Database configuration (PostgreSQL)
DPI_DB_URL=postgresql+psycopg2://dpi_user:dpi_password@postgres:5432  # Use postgres container name or AWS RDS endpoint/dpi_ls
DPI_ENV=production

# Task Queue (Redis + Celery)
CELERY_BROKER_URL=redis://redis:6379     # Use redis container name or AWS ElastiCache endpoint/0
CELERY_RESULT_BACKEND=redis://redis:6379     # Use redis container name or AWS ElastiCache endpoint/0

# Agent Evaluation AI Integration
OPENAI_API_KEY=your_openai_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Telemetry / AgentOps
AGENTOPS_API_KEY=your_agentops_api_key_here

# Telemetry / Langfuse
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=http://127.0.0.1:3000 # Use external host URL for Langfuse if hosted elsewhere

# OTel / Tracing Endpoints
JAEGER_ENDPOINT=http://otel-collector:14268
PROMETHEUS_URL=http://prometheus:9090

# Frontend Configuration
WIDGET_ALLOWED_ORIGINS=*
